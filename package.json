{
  "name": "rex-tools",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch server/index.ts\" \"vite\"",
    "build": "vite build && npm run build:server",
    "start": "node dist-server/index.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:static": "tsx scripts/export-static-data.mts && vite build --mode static",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist-server/index.mjs"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsx": "^4.20.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.16.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "roboto-fontface": "^0.10.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.6",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^3.2.4",
    "esbuild": "0.25.12"
  },
  "engines": {
    "node": ">=20"
  }
}
